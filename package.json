{
  "name": "dranix",
  "version": "0.1.0",
  "description": "Multi-agent TUI orchestrator \u2014 route messages across Codex, Claude Code, Pi, and more",
  "type": "module",
  "bin": {
    "dranix": "./dist/index.js"
  },
  "files": [
    "dist",
    "agents.example.toml",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/add-shebang.mjs",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "keywords": [
    "tui",
    "multi-agent",
    "orchestrator",
    "codex",
    "claude"
  ],
  "license": "MIT",
  "dependencies": {
    "smol-toml": "^1.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.8"
  }
}
